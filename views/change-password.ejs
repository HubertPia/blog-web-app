<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="styles/main.css" />
    <title>Zmiana Hasła</title>
  </head>
  <body>
    <div class="auth-container">
      <div class="info-panel">
        <h1>Zmiana Hasła</h1>
        <p>
          Pamiętaj, aby nowe hasło było silne i unikalne, aby zapewnić
          bezpieczeństwo Twojego konta.
        </p>
      </div>
      <div class="form-panel">
        <h2>Zmień swoje hasło</h2>
        <% if (locals.success && success.length > 0) { %>
        <p class="success-message"><%= success %></p>
        <% } %> <% if (locals.error && error.length > 0) { %>
        <p class="error-message"><%= error %></p>
        <% } %>
        <form action="/change-password" method="POST">
          <input
            type="password"
            name="oldPassword"
            placeholder="Stare hasło"
            required
            minlength="6"
          />
          <input
            type="password"
            name="newPassword"
            placeholder="Nowe hasło"
            required
            minlength="6"
          />
          <button type="submit">Zmień hasło</button>
        </form>
        <p class="toggle-link"><a href="/index">Wróć na stronę główną</a></p>
      </div>
    </div>
  </body>
</html>
