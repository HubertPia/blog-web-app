<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="styles/main.css" />
    <title>Zresetuj hasło</title>
  </head>
  <body>
    <div class="auth-container">
      <div class="info-panel">
        <h1>Reset hasła</h1>
        <p>
          Podaj adres e-mail powiązany z Twoim kontem, a wyślemy Ci kod
          weryfikacyjny.
        </p>
      </div>
      <div class="form-panel">
        <h2>Odzyskiwanie konta</h2>

        <% if (locals.error_msg && error_msg.length > 0) { %>
        <p class="error-message"><%= error_msg %></p>
        <% } %> <% if (locals.success_msg && success_msg.length > 0) { %>
        <p class="success-message"><%= success_msg %></p>
        <% } %>

        <form action="/forgot-password" method="POST">
          <input type="email" name="email" placeholder="Twój e-mail" required />
          <button type="submit">Wyślij kod</button>
        </form>

        <p class="toggle-link"><a href="/">Wróć do logowania</a></p>
      </div>
    </div>
  </body>
</html>
